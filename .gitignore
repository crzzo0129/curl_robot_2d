!results/rollingquad_abd10_speed_discovery_zero_contact/01_speed_discovery_zero_contact/best_phase_controller.json

# Version the CEM cycle dataset required by stand-to-roll BC and PPO training.
!results/cem_cycle_data/
!results/cem_cycle_data/cem_cycles.npz
!results/cem_cycle_data/cem_cycles.json

# Version the validated rolling-reset dataset required by stopping PPO.
# Other rolling-stop searches, reports, and generated terminal states remain local.
!results/rolling_stop/
!results/rolling_stop/low_speed_snapshots_0p40hz.npz
!results/rolling_stop/low_speed_snapshots_0p40hz.json

# Version the walking-start snapshot bank required by the walk->compact
# stage-one training (scripts.collect_walking_start_snapshots).
!results/walk_start_snapshots_0p4/
!results/walk_start_snapshots_0p4/walk_start_snapshots.npz
!results/walk_start_snapshots_0p4/walk_start_snapshots_meta.json

# Version the +90° Roll-to-Stand handoff banks required by residual/absolute
# dynamic roll-to-stand training (scripts.collect_reference_roll_to_stand).
!results/roll_to_stand_reference_residual/
!results/roll_to_stand_reference_residual/handoffs_*.npz
!results/roll_to_stand_reference_residual/handoffs_*.summary.json

# Local training services and logs.
wandb/
ppo_logs/
ppo_logs_cloud/
ppo_models/
ppo_models_cloud/
mjx_runs/
*.tfevents.*

# Cloud transfer bundle for the calibrated high-speed CEM steering map.
!results/cem_steering_calibration_v1.zip
!results/rolling_distill_review_v1.zip
!results/rolling_low_speed_recovery_v1.zip
