renders/
*.log

# Local report/build scratch.
ppt_design_exploration_build/
results/**/pptx_check/
results/**/pptx_check.zip
results/**/CURL_robot_design_exploration_CN/
results/**/*.inspect.ndjson

# Generated experiment outputs.
#
# Keep results ignored by default: PPO checkpoints, rollout GIFs/NPZ/CSVs,
# CEM sweeps, torso-COM exploration, walking exploration, diagnostics, and
# smoke-test scratch directories should stay local unless explicitly force-added.
results/**

# Keep only controller references required by current training/smoke defaults.
!results/
!results/RESULTS_INDEX.md
# Cloud recovery bundle is transferred through Git.
!results/rolling_ppo_recovery_cloud_v2.zip
!results/rolling_ppo_candidate_eval_v3.zip
!results/rolling_ppo_tracking_v4.zip
!results/collision_constrained_cem/
!results/collision_constrained_cem/best_phase_controller.json
!results/collision_constrained_cem_foot_gap_2mm_short_contact/
!results/collision_constrained_cem_foot_gap_2mm_short_contact/best_phase_controller.json
!results/staged_cem_real_geometry_180_d50_foot60/
!results/staged_cem_real_geometry_180_d50_foot60/03_foot_gap_2mm/
!results/staged_cem_real_geometry_180_d50_foot60/03_foot_gap_2mm/best_phase_controller.json
!results/pupper_r127p5_open60_shell150_45_three_stage_cem/
!results/pupper_r127p5_open60_shell150_45_three_stage_cem/03_strict_forbidden_collision/
!results/pupper_r127p5_open60_shell150_45_three_stage_cem/03_strict_forbidden_collision/best_phase_controller.json
!results/simple_convex_warmstart_cem/
!results/simple_convex_warmstart_cem/03_strict_10s/
!results/simple_convex_warmstart_cem/03_strict_10s/best_phase_controller.json
!results/rollingquad_primitive_warmstart_cem/
!results/rollingquad_primitive_warmstart_cem/03_strict_10s/
!results/rollingquad_primitive_warmstart_cem/03_strict_10s/best_phase_controller.json
!results/rollingquad_primitive_stiff_cem/
!results/rollingquad_primitive_stiff_cem/03_strict_10s/
!results/rollingquad_primitive_stiff_cem/03_strict_10s/best_phase_controller.json

# High-speed zero-contact reference chain for command-conditioned training
# (train_mjx_3d_residual_ppo --recipe command_tracking_v1).
!results/rollingquad_abd10_high_speed_zero_contact_refine_smoke/
!results/rollingquad_abd10_high_speed_zero_contact_refine_smoke/01_zero_contact_speed_refine/
!results/rollingquad_abd10_high_speed_zero_contact_refine_smoke/01_zero_contact_speed_refine/best_phase_controller.json
